# backend/.env.example
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3003,http://127.0.0.1:3003,http://localhost:3007,http://127.0.0.1:3007
DATABASE_URL=sqlite+aiosqlite:///./strandedpool.db
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
COST_SCORE_WEIGHT=0.40
TIME_SCORE_WEIGHT=0.35
RELIABILITY_SCORE_WEIGHT=0.15
CONVENIENCE_SCORE_WEIGHT=0.10
